<Window x:Class="RhodiumVault.Views.ChangeMasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change master password"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Change master password" Style="{StaticResource H1}" Margin="0,0,0,4"/>
        <TextBlock Text="This re-encrypts your entire vault under the new password." Style="{StaticResource Caption}"
                   TextWrapping="Wrap" Margin="0,0,0,20"/>

        <TextBlock Text="Current master password" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="CurrentBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,12"/>

        <TextBlock Text="New master password" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="NewBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,4" PasswordChanged="NewBox_Changed"/>
        <TextBlock x:Name="StrengthText" Text="" Style="{StaticResource Caption}" Margin="0,0,0,12" Visibility="Collapsed"/>

        <TextBlock Text="Confirm new master password" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="ConfirmBox" Style="{StaticResource ModernPasswordBox}" Margin="0,0,0,12"/>

        <TextBlock Text="There is no recovery: if you forget your new master password, your data cannot be restored."
                   Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock x:Name="ErrorText" Text="" Style="{StaticResource Caption}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Change password" Style="{StaticResource AccentButton}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
